# 放逐 / Banishment —— 中文（简体）文案
# 作者：VIASR · Forge 1.12.2
# 占位符与原版一致：%1$s %2$s 为按位置替换的参数。
# 本文件同时被服务器端 L10n 读取用于拼双语聊天；装了本模组的客户端也会加载它。

banishment_dimension.prefix=放逐
banishment_dimension.actor.admin=管理员
banishment_dimension.actor.system=系统

# ---- 命令用法 ----
banishment_dimension.usage.banish=§7/banish <玩家名|list>
banishment_dimension.usage.unbanish=§7/unbanish <玩家名>
banishment_dimension.usage.return=§7/return <玩家名>
banishment_dimension.usage.escape=§7/escape
banishment_dimension.usage.banishtime=§7/banishtime <玩家名> <分钟> 或 /banishtime add|set <玩家名> <分钟>

# ---- /banish list ----
banishment_dimension.msg.list.empty=§f当前没有被放逐的玩家。
banishment_dimension.msg.list.header=§f当前被放逐 §e%1$s §f人：
banishment_dimension.msg.list.sep=、
banishment_dimension.msg.list.tag.pending=§7[待上线解除]
banishment_dimension.msg.list.tag.offline=§7[离线]
banishment_dimension.msg.list.tag.timed=§7[剩 %1$s 分钟]
banishment_dimension.msg.list.note=§8记录存于服务端存档的 %1$s/ 文件夹（纯文本 JSON，零 NBT），重启不丢。

# ---- 命令回执 ----
banishment_dimension.msg.err.already_banished=§c%1$s 已经处于放逐状态。
banishment_dimension.msg.err.not_banished=§c%1$s 当前没有被放逐。
banishment_dimension.msg.err.offline_no_record=§c玩家 %1$s 不在线，且在放逐记录文件夹里也没有他的记录。
banishment_dimension.msg.ok.banished=§a已将 §e%1$s §a放逐到维度 §c%2$s§a。用 /unbanish %1$s 解除。
banishment_dimension.msg.ok.released=§a已解除 §e%1$s §a的放逐，其背包与游戏模式已恢复，记录文件已删除。
banishment_dimension.msg.ok.pending_marked=§a已对离线玩家 §e%1$s §a挂上待解除标记（写入其记录文件），下次登录时自动回到原位并恢复背包。
banishment_dimension.msg.info.pending_already=§e%1$s §7已在待解除队列中，下次登录自动恢复。
banishment_dimension.msg.ok.returned=§a已把 §e%1$s §a送回主世界出生点。
banishment_dimension.msg.err.not_online=§c玩家 %1$s 不在线，无法传送。
banishment_dimension.msg.err.overworld_unavailable=§c主世界暂不可用，无法传送，请再试一次。
banishment_dimension.msg.err.return_banished=§c%1$s 正处于放逐状态，/return 只能对未被放逐的玩家使用；要解除放逐请用 /unbanish %1$s。

# ---- /banishtime 定时放逐 ----
banishment_dimension.msg.err.banishtime_bad_minutes=§c时间必须是正整数（分钟），不允许小数或 0。你输入的是：%1$s
banishment_dimension.msg.ok.banishtime_add=§a已把 §e%1$s §a的放逐时长增加 §e%2$s §a分钟，剩余 §e%3$s §a分钟（仅在线计时）。
banishment_dimension.msg.ok.banishtime_set=§a已把 §e%1$s §a的放逐时长设置为 §e%2$s §a分钟，剩余 §e%3$s §a分钟（仅在线计时）。

# ---- 发给被放逐/被解除玩家的通知 ----
banishment_dimension.msg.notice.banished=§c%1$s将你放逐到了放逐维度。在这里你将与世隔绝，直到管理员解除放逐。
banishment_dimension.msg.notice.banishtime_add=§a管理员把你的放逐时长增加了 §e%1$s §a分钟，剩余 §e%2$s §a分钟（仅在线计时）。
banishment_dimension.msg.notice.banishtime_set=§a管理员把你的放逐时长设置为 §e%1$s §a分钟，剩余 §e%2$s §a分钟（仅在线计时）。
banishment_dimension.msg.notice.released=§a%1$s解除了你的放逐。你已回到原来的世界，背包和游戏模式已恢复。
banishment_dimension.msg.notice.not_your_place=§e这里不是你可以停留的地方，已送你离开。
banishment_dimension.msg.notice.expired=§e你的放逐已到期，你已被送回到进入放逐之前的位置。
banishment_dimension.msg.notice.returned=§a%1$s把你送回了主世界。
banishment_dimension.msg.notice.returned_origin=§a你已回到进入放逐维度之前的位置。
banishment_dimension.msg.notice.escape_hint=§e你不是被放逐对象，却进入了放逐维度。使用 /escape 可回到进入前的位置，稍后也会自动送你回去。

# ---- 状态告警 ----
banishment_dimension.msg.err.already_in_dim=§c你已经在放逐维度里了。
banishment_dimension.msg.err.dim_not_loaded=§c放逐维度未加载，放逐失败，请联系管理员。
banishment_dimension.msg.err.escape_not_player=§c该指令只能由玩家在游戏内使用。
banishment_dimension.msg.err.escape_banished=§c你是被放逐对象，无法使用 /escape；请等待管理员用 /unbanish 解除。
banishment_dimension.msg.err.escape_not_in_dim=§c你当前不在放逐维度（114）中，无法使用 /escape。
banishment_dimension.msg.warn.pullback=§c放逐系统检测到你离开了放逐维度，已强制拉回！
banishment_dimension.msg.warn.dim_unavailable=§e放逐维度暂不可用，已自动解除你的放逐。
banishment_dimension.msg.warn.fallback_drop=§e放逐已解除，但原维度暂不可用，你的背包已掉落在脚下。

# ---- 控制台日志 ----
banishment_dimension.log.language=当前消息语言：%1$s（改 config/%2$s 里的 S:language 即可切换：zh / en / both）
banishment_dimension.log.server_stopping=服务器关闭：%1$s 条放逐记录已存入存档文件夹 %2$s/，重开服务器后自动续放。
banishment_dimension.log.server_started=已从服务端文件夹 %1$s 载入 %2$s 条放逐记录（纯文本 JSON，零 NBT），重启后续放。
banishment_dimension.log.banishtime_expired=定时放逐到期：%1$s 的放逐时间已走完，已自动解除并送回原位。

# ---- 游戏内配置页面（主界面 Mods → 放逐 / Banishment → Config）----
# Forge 原生配置界面用的是玩家客户端语言，与上面的 S:language 无关。
config.banishment.language=聊天消息语言
config.banishment.log_language=后台日志语言
